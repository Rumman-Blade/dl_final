{
  "name": "Class 7 Final Project",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "postCreateCommand": "bash scripts/install_dependencies.sh",
  "containerEnv": {
    "TF_NUM_INTRAOP_THREADS": "2",
    "TF_NUM_INTEROP_THREADS": "2",
    "OMP_NUM_THREADS": "2"
  },
  "forwardPorts": [
    8000,
    8501
  ],
  "portsAttributes": {
    "8000": {
      "label": "FastAPI"
    },
    "8501": {
      "label": "Streamlit",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ]
    }
  }
}
